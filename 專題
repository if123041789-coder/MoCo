<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>附近好友雷達</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 500px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            text-align: center;
        }

        .header h1 {
            font-size: 24px;
            margin-bottom: 5px;
        }

        .header p {
            opacity: 0.9;
            font-size: 14px;
        }

        .tabs {
            display: flex;
            background: #f5f5f5;
            border-bottom: 2px solid #e0e0e0;
        }

        .tab {
            flex: 1;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            background: none;
            font-size: 16px;
        }

        .tab.active {
            background: white;
            color: #667eea;
            font-weight: bold;
        }

        .content {
            padding: 20px;
            min-height: 400px;
        }

        .view {
            display: none;
        }

        .view.active {
            display: block;
        }

        .radar-container {
            position: relative;
            width: 300px;
            height: 300px;
            margin: 20px auto;
            background: radial-gradient(circle, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            box-shadow: 0 0 50px rgba(102, 126, 234, 0.5);
        }

        .radar-grid {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 90%;
            height: 90%;
        }

        .radar-circle {
            position: absolute;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .radar-circle:nth-child(1) { width: 100%; height: 100%; }
        .radar-circle:nth-child(2) { width: 66%; height: 66%; }
        .radar-circle:nth-child(3) { width: 33%; height: 33%; }

        .center-dot {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 15px;
            height: 15px;
            background: #fff;
            border-radius: 50%;
            box-shadow: 0 0 20px rgba(255,255,255,0.8);
            z-index: 10;
        }

        .friend-dot {
            position: absolute;
            width: 12px;
            height: 12px;
            background: #4ade80;
            border: 2px solid white;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            cursor: pointer;
            transition: all 0.3s;
            animation: pulse 2s infinite;
        }

        .friend-dot:hover {
            transform: translate(-50%, -50%) scale(1.3);
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 10px rgba(74, 222, 128, 0.5); }
            50% { box-shadow: 0 0 20px rgba(74, 222, 128, 1); }
        }

        .info-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin: 15px 0;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            opacity: 0.9;
            font-size: 14px;
        }

        .info-value {
            font-weight: bold;
            font-size: 16px;
        }

        .btn {
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f5f5f5;
            color: #333;
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        .connection-code {
            background: #f5f5f5;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            margin: 15px 0;
        }

        .code-display {
            font-size: 32px;
            font-weight: bold;
            color: #667eea;
            letter-spacing: 5px;
            margin: 10px 0;
            font-family: 'Courier New', monospace;
        }

        .qr-placeholder {
            width: 200px;
            height: 200px;
            margin: 15px auto;
            background: white;
            border: 3px solid #667eea;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: #999;
        }

        input[type="text"] {
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: #667eea;
        }

        .friend-list {
            margin: 15px 0;
        }

        .friend-item {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .friend-info {
            flex: 1;
        }

        .friend-name {
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .friend-distance {
            color: #667eea;
            font-size: 14px;
        }

        .friend-direction {
            width: 40px;
            height: 40px;
            background: #667eea;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
        }

        .message-container {
            max-height: 300px;
            overflow-y: auto;
            padding: 10px;
            background: #f9f9f9;
            border-radius: 10px;
            margin: 15px 0;
        }

        .message {
            padding: 10px 15px;
            margin: 5px 0;
            border-radius: 10px;
            max-width: 80%;
        }

        .message.sent {
            background: #667eea;
            color: white;
            margin-left: auto;
        }

        .message.received {
            background: white;
            color: #333;
        }

        .message-input {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .message-input input {
            flex: 1;
            margin: 0;
        }

        .message-input button {
            width: auto;
            padding: 15px 25px;
            margin: 0;
        }

        .status {
            padding: 10px;
            border-radius: 10px;
            margin: 10px 0;
            text-align: center;
            font-size: 14px;
        }

        .status.success {
            background: #d1fae5;
            color: #065f46;
        }

        .status.error {
            background: #fee2e2;
            color: #991b1b;
        }

        .status.warning {
            background: #fef3c7;
            color: #92400e;
        }

        @keyframes rotate {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        .compass-needle {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 4px;
            height: 40%;
            background: linear-gradient(to top, transparent, #fff);
            transform-origin: bottom center;
            animation: rotate 2s linear infinite;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📡 附近好友雷達</h1>
            <p>P2P 即時定位 · 無需伺服器</p>
        </div>

        <div class="tabs">
            <button class="tab active" onclick="switchView('radar')">雷達</button>
            <button class="tab" onclick="switchView('friends')">好友</button>
            <button class="tab" onclick="switchView('connect')">連線</button>
            <button class="tab" onclick="switchView('messages')">訊息</button>
        </div>

        <div class="content">
            <!-- 雷達視圖 -->
            <div id="radar" class="view active">
                <div class="info-card">
                    <div class="info-row">
                        <span class="info-label">📍 我的位置</span>
                        <span class="info-value" id="myCoords">獲取中...</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">🧭 方向</span>
                        <span class="info-value" id="myHeading">--°</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">👥 在線好友</span>
                        <span class="info-value" id="friendCount">0</span>
                    </div>
                </div>

                <div class="radar-container">
                    <div class="radar-grid">
                        <div class="radar-circle"></div>
                        <div class="radar-circle"></div>
                        <div class="radar-circle"></div>
                    </div>
                    <div class="center-dot"></div>
                    <div class="compass-needle"></div>
                    <div id="friendDots"></div>
                </div>

                <button class="btn btn-primary" onclick="toggleSharing()">
                    <span id="shareIcon">▶</span>
                    <span id="shareText">開始分享位置</span>
                </button>
            </div>

            <!-- 好友列表視圖 -->
            <div id="friends" class="view">
                <h2 style="margin-bottom: 15px; color: #333;">📋 好友列表</h2>
                <div id="friendList" class="friend-list">
                    <div class="status warning">目前沒有連線的好友</div>
                </div>
            </div>

            <!-- 連線視圖 -->
            <div id="connect" class="view">
                <h2 style="margin-bottom: 15px; color: #333;">🔗 連線配對</h2>
                
                <div class="connection-code">
                    <p style="color: #666; margin-bottom: 10px;">我的連線碼</p>
                    <div class="code-display" id="myCode">------</div>
                    <button class="btn btn-secondary" onclick="copyCode()">📋 複製連線碼</button>
                </div>

                <div style="text-align: center; margin: 20px 0; color: #999;">
                    <p>─── 或掃描 QR Code ───</p>
                </div>

                <div class="qr-placeholder" id="qrCode">
                    QR Code 顯示區
                </div>

                <div style="margin-top: 30px;">
                    <p style="color: #666; margin-bottom: 10px;">輸入好友的連線碼</p>
                    <input type="text" id="friendCodeInput" placeholder="例如: ABC123" maxlength="6">
                    <button class="btn btn-primary" onclick="connectToFriend()">🤝 連線好友</button>
                </div>

                <div id="connectionStatus"></div>
            </div>

            <!-- 訊息視圖 -->
            <div id="messages" class="view">
                <h2 style="margin-bottom: 15px; color: #333;">💬 訊息</h2>
                <div class="message-container" id="messageContainer">
                    <div class="status warning">開始與好友聊天吧！</div>
                </div>
                <div class="message-input">
                    <input type="text" id="messageInput" placeholder="輸入訊息...">
                    <button class="btn btn-primary" onclick="sendMessage()">發送</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 全域變數
        let myLocation = null;
        let myHeading = 0;
        let friends = {};
        let isSharing = false;
        let watchId = null;
        let myConnectionCode = generateCode();

        // 初始化
        document.getElementById('myCode').textContent = myConnectionCode;

        // 生成隨機連線碼
        function generateCode() {
            return Math.random().toString(36).substr(2, 6).toUpperCase();
        }

        // 切換視圖
        function switchView(viewName) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(viewName).classList.add('active');
            event.target.classList.add('active');
        }

        // 開始獲取位置
        function startLocationTracking() {
            if ("geolocation" in navigator) {
                watchId = navigator.geolocation.watchPosition(
                    position => {
                        myLocation = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude,
                            accuracy: position.coords.accuracy
                        };
                        updateLocationDisplay();
                        broadcastLocation();
                    },
                    error => {
                        showStatus('error', '無法獲取位置：' + error.message);
                    },
                    { enableHighAccuracy: true, maximumAge: 0, timeout: 5000 }
                );
            } else {
                showStatus('error', '您的裝置不支援定位功能');
            }
        }

        // 開始獲取方向
        function startHeadingTracking() {
            if (window.DeviceOrientationEvent) {
                window.addEventListener('deviceorientation', event => {
                    if (event.alpha !== null) {
                        myHeading = 360 - event.alpha;
                    } else if (event.webkitCompassHeading !== undefined) {
                        myHeading = event.webkitCompassHeading;
                    }
                    document.getElementById('myHeading').textContent = Math.round(myHeading) + '°';
                });
            }
        }

        // 更新位置顯示
        function updateLocationDisplay() {
            if (myLocation) {
                const coordText = `${myLocation.lat.toFixed(4)}, ${myLocation.lng.toFixed(4)}`;
                document.getElementById('myCoords').textContent = coordText;
            }
        }

        // 計算兩點距離（公里）
        function calculateDistance(lat1, lng1, lat2, lng2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLng = (lng2 - lng1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLng/2) * Math.sin(dLng/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }

        // 計算方位角
        function calculateBearing(lat1, lng1, lat2, lng2) {
            const dLng = (lng2 - lng1) * Math.PI / 180;
            const y = Math.sin(dLng) * Math.cos(lat2 * Math.PI / 180);
            const x = Math.cos(lat1 * Math.PI / 180) * Math.sin(lat2 * Math.PI / 180) -
                      Math.sin(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.cos(dLng);
            return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
        }

        // 更新雷達顯示
        function updateRadar() {
            const container = document.getElementById('friendDots');
            container.innerHTML = '';
            
            Object.values(friends).forEach(friend => {
                if (friend.location && myLocation) {
                    const distance = calculateDistance(
                        myLocation.lat, myLocation.lng,
                        friend.location.lat, friend.location.lng
                    );
                    
                    const bearing = calculateBearing(
                        myLocation.lat, myLocation.lng,
                        friend.location.lat, friend.location.lng
                    );

                    // 計算雷達上的位置（最大顯示5公里）
                    const maxDistance = 5; // 公里
                    const normalizedDistance = Math.min(distance / maxDistance, 1);
                    const radarRadius = 135; // 雷達半徑的90%
                    const distance2D = normalizedDistance * radarRadius;
                    
                    const angle = (bearing - myHeading) * Math.PI / 180;
                    const x = 150 + distance2D * Math.sin(angle);
                    const y = 150 - distance2D * Math.cos(angle);

                    const dot = document.createElement('div');
                    dot.className = 'friend-dot';
                    dot.style.left = x + 'px';
                    dot.style.top = y + 'px';
                    dot.title = `${friend.name} - ${distance.toFixed(2)}km`;
                    container.appendChild(dot);
                }
            });

            document.getElementById('friendCount').textContent = Object.keys(friends).length;
        }

        // 更新好友列表
        function updateFriendList() {
            const container = document.getElementById('friendList');
            
            if (Object.keys(friends).length === 0) {
                container.innerHTML = '<div class="status warning">目前沒有連線的好友</div>';
                return;
            }

            container.innerHTML = '';
            Object.entries(friends).forEach(([id, friend]) => {
                const item = document.createElement('div');
                item.className = 'friend-item';
                
                let distanceText = '距離未知';
                let directionIcon = '📍';
                
                if (friend.location && myLocation) {
                    const distance = calculateDistance(
                        myLocation.lat, myLocation.lng,
                        friend.location.lat, friend.location.lng
                    );
                    
                    if (distance < 1) {
                        distanceText = `${(distance * 1000).toFixed(0)}m`;
                    } else {
                        distanceText = `${distance.toFixed(2)}km`;
                    }

                    const bearing = calculateBearing(
                        myLocation.lat, myLocation.lng,
                        friend.location.lat, friend.location.lng
                    );
                    const directions = ['↑', '↗', '→', '↘', '↓', '↙', '←', '↖'];
                    const index = Math.round(bearing / 45) % 8;
                    directionIcon = directions[index];
                }

                item.innerHTML = `
                    <div class="friend-info">
                        <div class="friend-name">${friend.name}</div>
                        <div class="friend-distance">${distanceText}</div>
                    </div>
                    <div class="friend-direction">${directionIcon}</div>
                `;
                container.appendChild(item);
            });
        }

        // 切換分享狀態
        function toggleSharing() {
            isSharing = !isSharing;
            const icon = document.getElementById('shareIcon');
            const text = document.getElementById('shareText');
            
            if (isSharing) {
                icon.textContent = '⏸';
                text.textContent = '停止分享位置';
                startLocationTracking();
                startHeadingTracking();
                showStatus('success', '開始分享位置');
            } else {
                icon.textContent = '▶';
                text.textContent = '開始分享位置';
                if (watchId) navigator.geolocation.clearWatch(watchId);
                showStatus('warning', '已停止分享位置');
            }
        }

        // 模擬連線好友（實際應用需要WebRTC或其他P2P技術）
        function connectToFriend() {
            const code = document.getElementById('friendCodeInput').value.trim().toUpperCase();
            
            if (!code) {
                showStatus('error', '請輸入連線碼', 'connectionStatus');
                return;
            }

            if (code === myConnectionCode) {
                showStatus('error', '不能連線自己！', 'connectionStatus');
                return;
            }

            // 模擬新增好友
            const friendId = code;
            friends[friendId] = {
                name: `好友_${code.substr(0,3)}`,
                code: code,
                location: {
                    lat: myLocation ? myLocation.lat + (Math.random() - 0.5) * 0.01 : 25.0330,
                    lng: myLocation ? myLocation.lng + (Math.random() - 0.5) * 0.01 : 121.5654
                }
            };

            showStatus('success', `已成功連線好友 ${code}`, 'connectionStatus');
            document.getElementById('friendCodeInput').value = '';
            updateFriendList();
            updateRadar();

            // 模擬即時更新好友位置
            setInterval(() => {
                if (friends[friendId] && friends[friendId].location) {
                    friends[friendId].location.lat += (Math.random() - 0.5) * 0.0001;
                    friends[friendId].location.lng += (Math.random() - 0.5) * 0.0001;
                    updateRadar();
                    updateFriendList();
                }
            }, 3000);
        }

        // 廣播位置（模擬）
        function broadcastLocation() {
            // 實際應用中，這裡會通過WebRTC發送位置給所有連線的好友
            updateRadar();
            updateFriendList();
        }

        // 複製連線碼
        function copyCode() {
            navigator.clipboard.writeText(myConnectionCode).then(() => {
                showStatus('success', '已複製連線碼！', 'connectionStatus');
            });
        }

        // 發送訊息
        function sendMessage() {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            
            if (!text) return;

            addMessage(text, true);
            input.value = '';

            // 模擬收到回覆
            setTimeout(() => {
                addMessage('收到你的訊息了！', false);
            }, 1000);
        }

        // 新增訊息
        function addMessage(text, isSent) {
            const container = document.getElementById('messageContainer');
            
            // 移除提示訊息
            const warning = container.querySelector('.status');
            if (warning) warning.remove();

            const msg = document.createElement('div');
            msg.className = `message ${isSent ? 'sent' : 'received'}`;
            msg.textContent = text;
            container.appendChild(msg);
            container.scrollTop = container.scrollHeight;
        }

        // 顯示狀態訊息
        function showStatus(type, message, containerId = null) {
            const status = document.createElement('div');
            status.className = `status ${type}`;
            status.textContent = message;

            if (containerId) {
                const container = document.getElementById(containerId);
                container.innerHTML = '';
                container.appendChild(status);
            }

            setTimeout(() => status.remove(), 3000);
        }

        // 訊息輸入框支援 Enter 鍵
        document.getElementById('messageInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') sendMessage();
        });

        // 定期更新雷達
        setInterval(updateRadar, 100);

        // 生成簡易 QR Code
        setTimeout(() => {
            document.getElementById('qrCode').innerHTML = `
                <svg width="180" height="180" style="background: white;">
                    <rect x="10" y="10" width="20" height="20" fill="#667eea"/>
                    <rect x="40" y="10" width="20" height="20" fill="#667eea"/>
                    <rect x="70" y="10" width="20" height="20" fill="#667eea"/>
                    <rect x="130" y="10" width="20" height="20" fill="#667eea"/>
                    <rect x="160" y="10" width="20" height="20" fill="#667eea"/>
                    <text x="90" y="100" text-anchor="middle" fill="#667eea" font-size="14">${myConnectionCode}</text>
                </svg>
            `;
        }, 500);
    </script>
</body>
</html>
